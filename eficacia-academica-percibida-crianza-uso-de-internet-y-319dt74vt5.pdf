/Subject (espanolResumen\040El\040uso\040intensivo\040de\040internet\040puede\040contribuir\040a\040desarrollar\040disfunciones\040psicosociales\040graves\040en\040la\040adolescencia\056\040El\040objetivo\040de\040esta\040investigacion\040es\040analizar\040las\040relaciones\040de\040la\040percepcion\040de\040eficacia\040academica\040con\040el\040uso\040de\040internet\040para\040ocio\054\040los\040estilos\040de\040crianza\040y\040los\040problemas\040exteriorizados\040e\040interiorizados\040en\040la\040adolescencia\040\050agresividad\040proactiva\054\040reactiva\054\040fisica\040y\040verbal\054\040afiliacion\040a\040pares\040rebeldes\040e\040inestabilidad\040emocional\051\056\040Han\040participado\040762\040adolescentes\040de\04012\040a\04017\040anos\040\050M\040\075\04013\05669\073\040DT\040\075\0401\05640\073\040varones\04052\0568\045\051\056\040Utilizan\040internet\040en\040tiempo\040de\040ocio\040entre\040cero\040y\04098\040horas\040semanales\054\040de\040ahi\040que\040la\040poblacion\040se\040haya\040distribuido\040en\040cuartiles\056\040Las\040variables\040se\040han\040obtenido\040a\040traves\040de\040pruebas\040estandarizadas\056\040Los\040analisis\040estadisticos\040se\040basan\040en\040metodologia\040descriptiva\040y\040predictiva\056\040Los\040resultados\040han\040permitido\040obtener\040tres\040conclusiones\056\040Primera\054\040el\040numero\040de\040horas\040de\040internet\040para\040fines\040recreativos\040se\040relaciona\040con\040una\040peor\040eficacia\040academica\040percibida\056\040Segunda\054\040los\040adolescentes\040que\040usan\040Internet\040intensamente\040perciben\040mas\040permisividad\040de\040los\040padres\040y\040menos\040apoyo\040y\040comunicacion\040por\040parte\040de\040los\040padres\056\040Estos\040adolescentes\040presentan\040mas\040riesgo\040de\040conectarse\040con\040pares\040rebeldes\040y\040tienen\040indices\040mas\040altos\040de\040inestabilidad\040emocional\040y\040agresividad\040\050reactiva\054\040proactiva\054\040fisica\040y\040verbal\051\056\040Tercera\054\040la\040paternidad\040mas\040punitiva\054\040la\040agresividad\040y\040la\040afiliacion\040a\040pares\040rebeldes\040aumentan\040el\040uso\040intensivo\040de\040Internet\056\040Esta\040investigacion\040corrobora\040la\040necesidad\040de\040una\040formacion\040adecuada\054\040dirigida\040a\040fomentar\040el\040apoyo\040y\040la\040comunicacion\040paterno\055filial\040para\040educar\040el\040uso\040racional\040y\040responsable\040de\040internet\040de\040ambos\054\040padres\040y\040adolescentes\056\040EnglishAbstract\040The\040intensive\040use\040of\040the\040Internet\040can\040contribute\040to\040the\040development\040of\040serious\040psychosocial\040dysfunctions\040in\040adolescents\056\040The\040purpose\040of\040this\040research\040is\040to\040analyze\040the\040relationships\040between\040achievement\040perceived\040with\040the\040leisure\040use\040of\040the\040internet\054\040parenting\054\040and\040externalized\040and\040internalized\040problems\040during\040adolescence\040\050aggressiveness\040reactive\054\040proactive\054\040physical\040and\040verbal\054\040affiliation\040with\040deviant\040peers\040and\040emotional\040instability\051\056\040The\040sample\040is\040made\040of\040762\040adolescents\040from\04012\040to\04017\040years\040old\040\050M\040\075\04013\05669\054\040SD\040\075\0401\05640\051\054\040with\04052\0568\045\040of\040males\040and\04047\0562\045\040of\040females\056\040The\040use\040of\040internet\040in\040leisure\040time\040is\040between\0400\05598\040hours\040per\040week\056\040Hence\040the\040population\040has\040been\040distributed\040in\040quartiles\056\040The\040variables\040have\040been\040obtained\040through\040standardized\040tests\056\040Statistical\040analyzes\040are\040descriptive\040and\040predictive\040methodology\056\040The\040analyses\040carried\040out\040have\040allowed\040us\040to\040obtain\040three\040conclusions\056\040First\054\040the\040number\040of\040hours\040of\040internet\040for\040recreational\040purposes\040is\040related\040to\040worse\040achievement\040perceived\040of\040the\040adolescent\056\040Second\054\040it\040has\040been\040found\040that\040adolescents\040who\040use\040Internet\040intensively\040greater\040perceived\040permissiveness\040of\040the\040parents\040and\040a\040lower\040support\040and\040communication\040with\040them\056\040These\040adolescents\040present\040an\040increased\040risk\040of\040joining\040deviant\040peers\040and\040have\040higher\040rates\040of\040emotional\040instability\040and\040aggressiveness\040\050reactive\054\040proactive\054\040and\040physical\040and\040verbal\051\056\040Third\054\040more\040punitive\040parenting\054\040aggressiveness\040and\040affiliation\040with\040deviant\040peers\040boost\040the\040intensive\040use\040of\040the\040internet\056\040This\040empirical\040research\040corroborates\040the\040need\040for\040adequate\040training\040aimed\040at\040fostering\040parental\055child\040support\040and\040communication\040to\040educate\040the\040rational\040and\040responsible\040use\040of\040the\040Internet\040by\040both\040parents\040and\040adolescents\056)
